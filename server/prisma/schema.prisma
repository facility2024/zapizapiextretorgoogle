generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USUÁRIOS E LICENCIAMENTO ───────────────────────────────

model Usuario {
  id             String    @id @default(uuid())
  email          String    @unique
  senha          String    // bcrypt hash
  nome           String?
  whatsapp       String?   // telefone do usuário (opcional)
  role           String    @default("user") // "admin" | "user"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  licencas       Licenca[]
  instancias     UserInstance[]
  campanhas      Campanha[]
  contatos       Contato[]
  apiKeys        ApiKey[]
}

model Licenca {
  id             String   @id @default(uuid())
  usuarioId      String
  dataInicio     DateTime @default(now())
  dataExpiracao  DateTime
  ativo          Boolean  @default(true)
  criadoPor      String?  // ID do admin que criou
  createdAt      DateTime @default(now())
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model UserInstance {
  id             String   @id @default(uuid())
  usuarioId      String
  wapiInstanceId String
  wapiToken      String
  wapiApiKey     String?
  wapiBaseUrl    String   @default("https://api.w-api.app")
  geoapifyKeys   String?  // chaves Geoapify separadas por vírgula
  conectado      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId])
}

// ─── MODELOS EXISTENTES (com usuarioId) ─────────────────────

model Contato {
  id        String   @id @default(uuid())
  usuarioId String?  // null = legado (sem dono)
  numero    String
  nome      String?
  empresa   String?
  cidade    String?
  extras    String?  @default("{}")
  createdAt DateTime @default(now())
  campanhas CampanhaContato[]
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, numero])
}

model Campanha {
  id                 String            @id @default(uuid())
  usuarioId          String?
  nome               String
  tipoDisparo        String
  textoMensagem      String
  imagemUrl          String?
  imagensUrls        String?
  audioUrl           String?
  variavelFallback   String?
  status             String            @default("rascunho")
  agendarPara        DateTime?
  totalContatos      Int               @default(0)
  enviados           Int               @default(0)
  erros              Int               @default(0)
  delayEntreMsgMin   Int               @default(20)
  delayEntreMsgMax   Int               @default(40)
  delayImagemTexto   Int               @default(4)
  limitePorHora      Int?
  limitePorDia       Int?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  contatos           CampanhaContato[]
  envios             Envio[]
  usuario            Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model CampanhaContato {
  id         String   @id @default(uuid())
  campanhaId String
  contatoId  String
  status     String   @default("pendente")
  errorMsg   String?
  createdAt  DateTime @default(now())
  enviadoEm  DateTime?
  campanha   Campanha @relation(fields: [campanhaId], references: [id])
  contato    Contato  @relation(fields: [contatoId], references: [id])

  @@unique([campanhaId, contatoId])
}

model Envio {
  id         String   @id @default(uuid())
  campanhaId String
  contatoId  String
  tipo       String
  status     String
  response   String?
  errorMsg   String?
  enviadoEm  DateTime @default(now())
  campanha   Campanha @relation(fields: [campanhaId], references: [id])
}

model ConfiguracaoDelay {
  id              String @id @default(uuid())
  chave           String @unique
  valor           String
  descricao       String?
}

model ApiKey {
  id          String   @id @default(uuid())
  usuarioId   String?  // null = global/legado
  label       String?
  key         String   @unique
  ativo       Boolean  @default(true)
  falhas      Int      @default(0)
  ultimoErro  String?
  ultimoUso   DateTime?
  createdAt   DateTime @default(now())
  usuario     Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}
