WAPI_INSTANCE_ID=
WAPI_TOKEN=
# Chave da CONTA w-api.app (diferente do token de instância).
# Usada para criar/auto-provisionar a instância via POST /v1/client/create-instance.
WAPI_API_KEY=
WAPI_BASE_URL=https://api.w-api.app
PORT=3001
# Banco de dados
# Para usar Supabase (Postgres), cole a Connection string do projeto Supabase
# (use a do POOLER, porta 6543, em Settings -> Database).
# Exemplo: postgresql://postgres.xxxxxx:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Mantenha o arquivo supabase.sql executado no SQL Editor do Supabase.
DATABASE_URL=""
# Chave do Geoapify para o extrator via Places API (free tier: 3.000 req/dia por projeto, sem cartão).
# Crie em https://myprojects.geoapify.com/ (um projeto = uma chave). É a ÚNICA fonte do extrator.
GEOAPIFY_KEY=
