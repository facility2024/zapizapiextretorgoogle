WAPI_INSTANCE_ID=
WAPI_TOKEN=
# Chave da CONTA w-api.app (diferente do token de instância).
# Usada para criar/auto-provisionar a instância via POST /v1/client/create-instance.
WAPI_API_KEY=
WAPI_BASE_URL=https://api.w-api.app
PORT=3001
# Banco local (SQLite) — funciona em qualquer host com disco persistente
# No Easypanel, monte um volume no caminho do banco para não perder os dados.
DATABASE_URL="file:./dev.db"
# Chave da RapidAPI para o Extrator do Google Maps (local-business-data / OpenWeb Ninja).
# Fallback usado APENAS quando nenhuma chave estiver cadastrada em "API Google".
# Recomendado: cadastre várias chaves em API Google (rotação automática) e deixe isto vazio.
RAPIDAPI_KEY=
